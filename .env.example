# Copie para .env e preencha os valores

# Moodle
MOODLE_URL=https://moodle.example.com
MOODLE_TOKEN=

# Banco MySQL local (instalado no PC, ex.: via MySQL Workbench)
# Porta padrão 3306; se o seu MySQL usa outra (ex.: 3307), altere na URL.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/avamj

# OpenAI (Professor Virtual)
OPENAI_API_KEY=

# LTI (opcional)
LTI_SECRET=
LTI_KEY=
